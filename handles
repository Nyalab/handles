#!/usr/bin/env bash
set -euo pipefail

export HANDLES_PATH
HANDLES_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

. "$HANDLES_PATH/src/helpers.sh"

if [[ $# -gt 0 ]]; then
  case "$1" in
    config)
      shift
      . "$HANDLES_PATH/scripts/config.sh"
      ;;
    *)
      display_error "usage: ./handles [config <export|apply> <module>]"
      exit 1
      ;;
  esac
  exit $?
fi

actions=(setup update leave)

echo "🤖 what do you want to do?"
select action in "${actions[@]}"; do
  case "$action" in
    setup) . "$HANDLES_PATH/scripts/setup.sh" ;;
    update) display_warning "update is not implemented yet" ;;
    leave) display_info "bye" ;;
    *) display_error "invalid choice, try again"; continue ;;
  esac
  break
done
