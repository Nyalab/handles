# alias k=kubectl
# alias kstud='kubectl config set-context --current --namespace=studio'
# alias kprod='kubectl config set-context --current --namespace=production'

# prompt
prompt_emojis=(💩 🐦 🚀 🐞 🎨 🍕 🐭 👽 ☕️ 🔬 💀 🐷 🐼 🐶 🐸 🐧 🐳 🍔 🍣 🍻 🔮 💰 💎 💾 💜 🍪 🌞 🌍 🐌 🐓 🍄)

setopt PROMPT_SUBST # re-run the functions below each time the prompt is drawn

prompt_status() {
  echo -n "%(?.%F{green}.%F{red})● %f"
}

prompt_user() {
  [[ $UID -eq 0 ]] && echo -n "%K{red}%F{white}root %k%f"
}

# shortened path: every folder but the last is reduced to its first letter (~/d/p/handles)
prompt_dir() {
  local parts=("${(@s:/:)${(%):-%~}}") out i
  for ((i = 1; i < $#parts; i++)); do
    out+="${parts[i]:0:1}/"
  done
  out+="${parts[-1]}"
  echo -n "%F{blue}${out//\%/%%} %f"
}

prompt_git() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return
  local stash ref
  echo -n "%F{magenta}"
  [[ -n "$(git status --porcelain 2>/dev/null | tail -n1)" ]] && echo -n "* "
  stash=$(git rev-list --walk-reflogs --count refs/stash 2>/dev/null)
  [[ -n "$stash" ]] && echo -n "≡$stash "
  ref=$(git symbolic-ref HEAD 2>/dev/null) || ref=$(git show-ref --head -s --abbrev | head -n1 2>/dev/null)
  echo -n "${ref#refs/heads/} %f"
}

PROMPT='
%{%f%b%k%}$(prompt_status)${prompt_emojis[RANDOM % $#prompt_emojis + 1]} $(prompt_user)$(prompt_dir)\$ '
RPROMPT='$(prompt_git)'

# completions
setopt ALWAYS_TO_END # cursor to the end of the word after completing
# setopt PATH_DIRS # complete commands containing a slash through the PATH (bin/cons<tab>)
# already zsh defaults:
# setopt AUTO_MENU
# setopt AUTO_PARAM_SLASH
# setopt AUTO_REMOVE_SLASH
# setopt AUTO_LIST
# unsetopt MENU_COMPLETE

# extra definitions from the zsh-completions package, must come before compinit
[[ -d "$HOMEBREW_PREFIX/share/zsh-completions" ]] && fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)

# turn the completion system on, with a full security check only once per 20 hours (-C skips it)
autoload -Uz compinit
_comp_files=($HOME/.zcompdump(Nm-20))
if (( $#_comp_files )); then
  compinit -i -C
else
  compinit -i
fi
unset _comp_files

zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' # case insensitive
zstyle ':completion::complete:*' use-cache on # cache slow completions
zstyle ':completion::complete:*' cache-path $HOME/.zcompcache

