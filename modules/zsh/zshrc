# sourced by ~/.zshrc, see modules/zsh/install.sh

# directories
setopt AUTO_CD
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT
# setopt PUSHD_TO_HOME

# history
HISTSIZE=9999
SAVEHIST=9999
setopt HIST_IGNORE_ALL_DUPS
# setopt HIST_IGNORE_DUPS
setopt HIST_REDUCE_BLANKS
# setopt HIST_SAVE_NO_DUPS
setopt INC_APPEND_HISTORY

# I/O and globbing
unsetopt CLOBBER # '>' refuses to overwrite an existing file, use '>|' to force
# setopt EXTENDED_GLOB
# setopt MULTIOS # already the zsh default

# keybindings
bindkey -e # emacs-style editing (zsh would switch to vi mode if EDITOR contains "vi")
bindkey "^[^[[D" backward-word # alt-left
bindkey "^[^[[C" forward-word # alt-right
# bindkey "^[^?" backward-kill-word # alt-backspace, already the emacs mode default
bindkey "^[[3~" delete-char # delete
# bindkey "^[3;5~" delete-char # ctrl-delete, obscure terminal code

# aliases: viewing and listing
alias cat="bat"
alias grep="grep --color=auto"
alias less="less -R"
alias top="btop"
alias df="df -h"
# alias man="LC_ALL=C LANG=C man"
alias ls="eza -F" # with suffixes (/ for dirs, etc.)
# alias sl="eza -F" # for typos
alias l="eza -a1" # one per line, with hidden files
alias ll="eza -lF --git" # detailed
alias la="eza -alF --git" # detailed with hidden files
alias lt="eza -a --tree" # tree
alias lt1="eza -a --tree -L1" # tree level 1
alias lt2="eza -a --tree -L2" # tree level 2
# alias llt="eza -a --tree" # duplicate of lt
# alias llt1="eza -a --tree -L1" # duplicate of lt1
# alias llt2="eza -a --tree -L2" # duplicate of lt2
alias lr="eza -R" # recurse

# aliases: safety, ask before overwriting or deleting
alias cp="cp -i"
alias ln="ln -i"
alias mv="mv -i"
alias rm="rm -i"

# aliases: misc
alias ezs="vim ${0:A}" # edit this file ($0:A is its absolute path, symlinks resolved)
alias szs='source ~/.zshrc'
alias h='history -iD' # history with dates and durations
alias v=vim
alias pn=pnpm
