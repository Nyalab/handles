[alias]
	# list aliases
	aliases = config --get-regexp ^alias\\.
	# short status with branch
	s = status -sb
	st = status
	c = commit
	co = checkout
	sw = switch
	rs = restore
	b = branch
	# add to last commit, keep message, reset author date
	amend = commit --amend --no-edit --date=now
	# graph log, one line per commit
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	# pull, rebase, stash and restore local changes
	spp = pull --rebase --autostash
	# safe force push
	please = push --force-with-lease --force-if-includes
	# add all, amend, force push
	aap = !git add . && git amend && git please
	# delete local branches merged into current (merge commits only)
	del-merged = "!git branch --merged | grep -vE '^[*+]|^[[:space:]]*(main|master|develop)$' | xargs -n 1 git branch -d"
	# delete local branches whose remote is gone (squash-merged PRs), forced
	del-gone = "!git fetch -p && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2==\"[gone]\" {print $1}' | xargs -n 1 git branch -D"
	# delete a branch locally and on origin, forced: git del-branch <name>
	del-branch = "!f() { git branch -D \"$1\" && git push origin --delete \"$1\"; }; f"

