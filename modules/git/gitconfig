[branch]
	# most recent first
	sort = -committerdate

[tag]
	sort = -creatordate

[fetch]
	# drop remote branches deleted upstream
	prune = true

[pull]
	rebase = true

[push]
	# first push sets upstream
	autoSetupRemote = true

[rebase]
	# reorder fixup! commits
	autosquash = true

[merge]
	# conflicts show the common ancestor
	conflictStyle = zdiff3

[core]
	pager = delta
	# pager = diff-so-fancy | less --tabs=4 -RFX
	# editor = vim

[interactive]
	diffFilter = delta --color-only
	# diffFilter = diff-so-fancy --patch

